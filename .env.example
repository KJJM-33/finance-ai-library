# Copy to .env and fill in your keys.
# Only install / configure the providers you use.

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4 etc.)
OPENAI_API_KEY=sk-...

# For OpenAI-compatible providers (Ollama, Groq, Mistral, etc.)
# set OPENAI_API_KEY and pass --base-url to the CLI, or configure in the Streamlit UI.
# Ollama example: base_url = http://localhost:11434/v1  |  api_key = ollama
